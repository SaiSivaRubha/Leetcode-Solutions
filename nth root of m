class Solution {
    public int val(int base,int exp,int limit){
        int result=1;
        for(int i=0;i<exp;i++){
            result=result*base;
            if(result>limit) break;
        }
        return result;
    }
    public int nthRoot(int n, int m) {
        // code here
        if(m==0) return 0;
        if(n==1) return m;
        int low=0,high=m,res=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            res=val(mid,n,m);
            if(res==m) return mid;
            else if(res>m)  high=mid-1;
            else low=mid+1;
            
        }
        return -1;
    }
}